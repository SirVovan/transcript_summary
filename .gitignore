# Python
__pycache__/
*.pyc

# Транскрипты и выходные файлы скилла — не коммитить (результат работы, не код)
transcripts/**
!transcripts/.gitkeep

# Одноразовые patch-скрипты Слоя 3 — артефакты конкретных лекций, не код скилла.
# Шаблон для копирования: .claude/skills/konspekt/recon_patch_template.py
# Живут в _patches/, самоуничтожаются через 7 дней после создания.
patch_recon_*.py
_patches/*
!_patches/.gitkeep

# Playwright MCP — снимки и логи браузера, пишутся плагином в cwd
.playwright-mcp/

# OS
.DS_Store
Thumbs.db
